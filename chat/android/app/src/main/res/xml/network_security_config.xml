<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext only to the tailnet. The canvas speaks plain http on Tailscale
  (http://100.103.43.93:8781); WireGuard already encrypts that hop, and
  nothing else may go out unencrypted.

  Network security config matches host NAMES, not address ranges, so the
  CGNAT block Tailscale uses (100.64.0.0/10) cannot be written here. Listed:
  every *.ts.net MagicDNS name, and the tailnet IPs a canvas runs on today.
  Pairing a canvas on another tailnet IP: add it below, or pair by its
  MagicDNS name (red5.eagle-dubhe.ts.net).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
        <!-- red5, the canvas the app pairs with -->
        <domain includeSubdomains="false">100.103.43.93</domain>
        <!-- the app's own page (http://localhost, served in-process) -->
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

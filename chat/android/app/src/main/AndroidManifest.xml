<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The digital-assistant slot: with this the app can be chosen
                 under Default apps > Digital assistant, so the assist gesture,
                 the power key's long press and an earbud's long press open it
                 (David, 22 Sep 2026: Next takes the slot from the old
                 Sasonica). Only the intent arrives: no microphone, no
                 lock-screen session. AssistPlugin turns it into a new chat
                 that starts dictation itself. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- Background notifications (NotifyService): one stream to the
             paired server while the app is closed, no Firebase. specialUse,
             not dataSync: Android 15 stops a dataSync service after 6 hours
             a day, and this one runs all day. -->
        <service
            android:name=".NotifyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps one connection open to the user's own self-hosted Sasonica server so it can notify them when a reply finishes or a question waits, without Firebase Cloud Messaging." />
        </service>

        <!-- Speech (SpeechService): the player red5 drives over a socket,
             and a foreground service because a player on an activity is
             frozen about a minute after it leaves the screen. mediaPlayback,
             which is what it is; that type may not start from BOOT_COMPLETED
             on Android 15, so opening the app is what starts it. -->
        <service
            android:name=".speech.SpeechService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The two buttons on the waiting card, while a reply waits out a
             call or a conversation. -->
        <receiver
            android:name=".speech.SpeechReceiver"
            android:exported="false" />

        <!-- Restarts it after a reboot or an update, when it is on. -->
        <receiver
            android:name=".NotifyBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "New reply" / "Needs you" (Android 13+ asks for it at run time). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Background notifications (NotifyService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Speech (SpeechService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Dictation (SpeechInputPlugin): Android 11+ hides other apps' services
         unless the app says which it looks for, and without these the
         recogniser is invisible — resolveActivity returns null and
         isRecognitionAvailable says no, on a phone that has both. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>
</manifest>
